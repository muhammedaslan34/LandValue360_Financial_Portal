LV360_PORTAL_ENV=development
LV360_PORTAL_SECRET_KEY=change-this-to-a-long-random-secret
LV360_PORTAL_BASE_URL=http://127.0.0.1:8090
LV360_PORTAL_DATABASE_URL=sqlite+pysqlite:///./data/portal.db
LV360_PORTAL_STORAGE_BACKEND=local
LV360_PORTAL_LOCAL_STORAGE_PATH=./data/private
LV360_PORTAL_S3_ENDPOINT_URL=
LV360_PORTAL_S3_PUBLIC_ENDPOINT_URL=
LV360_PORTAL_S3_REGION=us-east-1
LV360_PORTAL_S3_BUCKET=lv360-private
LV360_PORTAL_S3_ACCESS_KEY=
LV360_PORTAL_S3_SECRET_KEY=
LV360_PORTAL_EMAIL_BACKEND=console
LV360_PORTAL_SMTP_HOST=
LV360_PORTAL_SMTP_PORT=587
LV360_PORTAL_SMTP_USERNAME=
LV360_PORTAL_SMTP_PASSWORD=
LV360_PORTAL_SMTP_FROM=notifications@example.com
LV360_PORTAL_SMTP_STARTTLS=true
LV360_PORTAL_AUTO_VERIFY_EMAIL=true
LV360_PORTAL_SESSION_HOURS=12
LV360_PORTAL_MAX_UPLOAD_MB=25
LV360_PORTAL_PROJECT_STORAGE_MB=250
LV360_PORTAL_MAX_PACKAGE_MB=50
LV360_PORTAL_SLA_HOURS=24
LV360_PORTAL_TIMEZONE=Asia/Damascus
LV360_PORTAL_COOKIE_SECURE=false
LV360_PORTAL_TRUSTED_HOSTS=127.0.0.1,localhost
